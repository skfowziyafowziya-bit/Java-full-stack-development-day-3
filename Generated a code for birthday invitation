<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>🎂 Babblu's Birthday Celebration 🎉</title>

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family: "Trebuchet MS", Arial, sans-serif;
      color: #ffffff;
      overflow-x: hidden;
      background: linear-gradient(
        -45deg,
        #ff4e8a,
        #7b2cff,
        #00c6ff,
        #00e676,
        #ff9800
      );
      background-size: 500% 500%;
      animation: backgroundMove 12s ease infinite;
    }

    @keyframes backgroundMove {
      0% { background-position: 0% 50%; }
      50% { background-position: 100% 50%; }
      100% { background-position: 0% 50%; }
    }

    /* Floating balloons */
    .balloon {
      position: fixed;
      bottom: -150px;
      font-size: 60px;
      z-index: 0;
      opacity: 0.8;
      animation: fly 12s linear infinite;
    }

    .b1 { left: 5%; animation-delay: 0s; }
    .b2 { left: 20%; animation-delay: 3s; }
    .b3 { left: 45%; animation-delay: 6s; }
    .b4 { left: 70%; animation-delay: 2s; }
    .b5 { left: 90%; animation-delay: 8s; }

    @keyframes fly {
      0% {
        transform: translateY(0) rotate(0deg);
      }

      100% {
        transform: translateY(-130vh) rotate(20deg);
      }
    }

    /* Navigation */
    nav {
      position: sticky;
      top: 0;
      z-index: 100;
      display: flex;
      justify-content: center;
      gap: 25px;
      flex-wrap: wrap;
      padding: 18px;

      background: rgba(0, 0, 0, 0.30);
      backdrop-filter: blur(12px);
    }

    nav a {
      color: white;
      text-decoration: none;
      font-weight: bold;
      padding: 8px 15px;
      border-radius: 20px;
      transition: 0.3s;
    }

    nav a:hover {
      background: white;
      color: #ff4081;
      transform: scale(1.1);
    }

    /* Hero */
    .hero {
      min-height: 95vh;
      display: flex;
      justify-content: center;
      align-items: center;
      text-align: center;
      position: relative;
      z-index: 2;
      padding: 40px 20px;
    }

    .hero-box {
      width: min(950px, 95%);
      padding: 55px 30px;
      border-radius: 35px;

      background: rgba(255, 255, 255, 0.17);
      backdrop-filter: blur(14px);

      border: 2px solid rgba(255,255,255,0.4);

      box-shadow:
        0 15px 50px rgba(0,0,0,0.3),
        inset 0 0 30px rgba(255,255,255,0.15);

      animation: heroEntrance 1.5s ease;
    }

    @keyframes heroEntrance {
      from {
        opacity: 0;
        transform: translateY(60px);
      }

      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .cake {
      font-size: 100px;
      animation: bounce 2s infinite;
    }

    @keyframes bounce {
      0%, 100% {
        transform: translateY(0);
      }

      50% {
        transform: translateY(-15px);
      }
    }

    .hero h1 {
      font-size: clamp(45px, 8vw, 90px);
      margin: 15px 0;

      background: linear-gradient(
        90deg,
        #fff700,
        #ffffff,
        #ffeb3b,
        #ffffff
      );

      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;

      text-shadow: 0 5px 25px rgba(0,0,0,0.15);
    }

    .hero h2 {
      font-size: clamp(22px, 4vw, 40px);
      color: #fff9c4;
      margin-bottom: 20px;
    }

    .hero p {
      max-width: 700px;
      margin: auto;
      font-size: 19px;
      line-height: 1.7;
    }

    .date-badge {
      display: inline-block;
      margin-top: 30px;
      padding: 15px 30px;
      border-radius: 50px;

      background: linear-gradient(135deg, #fff700, #ff9800);
      color: #6a1b9a;
      font-size: 20px;
      font-weight: bold;

      box-shadow: 0 8px 25px rgba(0,0,0,0.25);
    }

    /* Sections */
    section {
      position: relative;
      z-index: 2;
      padding: 80px 20px;
    }

    .section-title {
      text-align: center;
      font-size: clamp(35px, 6vw, 55px);
      margin-bottom: 45px;
      text-shadow: 0 4px 10px rgba(0,0,0,0.25);
    }

    .section-subtitle {
      text-align: center;
      font-size: 18px;
      margin: -30px auto 40px;
      max-width: 700px;
      color: #fffde7;
    }

    .container {
      max-width: 1150px;
      margin: auto;
    }

    .cards {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
      gap: 25px;
    }

    .card {
      text-align: center;
      padding: 30px 20px;
      border-radius: 25px;

      background: rgba(255,255,255,0.20);
      backdrop-filter: blur(12px);
      border: 1px solid rgba(255,255,255,0.4);

      box-shadow: 0 10px 30px rgba(0,0,0,0.18);

      transition: all 0.4s ease;
    }

    .card:hover {
      transform: translateY(-12px) scale(1.04);
      background: rgba(255,255,255,0.30);
      box-shadow: 0 18px 40px rgba(0,0,0,0.30);
    }

    .card-icon {
      font-size: 60px;
      margin-bottom: 15px;
    }

    .card h3 {
      color: #fff176;
      font-size: 23px;
      margin-bottom: 12px;
    }

    .card p {
      line-height: 1.6;
    }

    /* Event Information */
    .event-box {
      max-width: 850px;
      margin: auto;
      padding: 45px;
      border-radius: 30px;

      background: rgba(0,0,0,0.25);
      backdrop-filter: blur(15px);
      box-shadow: 0 15px 50px rgba(0,0,0,0.3);
    }

    .event-row {
      display: flex;
      align-items: center;
      gap: 20px;

      background: rgba(255,255,255,0.14);

      padding: 20px;
      margin: 15px 0;
      border-radius: 18px;

      transition: 0.3s;
    }

    .event-row:hover {
      transform: translateX(8px);
      background: rgba(255,255,255,0.25);
    }

    .event-row span {
      font-size: 38px;
    }

    .event-row h3 {
      color: #fff176;
      margin-bottom: 5px;
    }

    /* Countdown */
    .countdown {
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: 20px;
      margin-top: 35px;
    }

    .count-box {
      min-width: 120px;
      padding: 20px;
      border-radius: 20px;

      background: rgba(0,0,0,0.3);

      text-align: center;
      box-shadow: 0 8px 20px rgba(0,0,0,0.2);
    }

    .count-box span {
      display: block;
      font-size: 38px;
      font-weight: bold;
      color: #fff176;
    }

    /* Highlight */
    .highlight {
      color: #fff176;
      font-weight: bold;
    }

    /* Invitation */
    .invitation {
      max-width: 900px;
      margin: auto;
      text-align: center;

      background: rgba(255,255,255,0.17);
      border: 2px solid rgba(255,255,255,0.4);
      border-radius: 35px;

      padding: 60px 25px;

      box-shadow: 0 15px 50px rgba(0,0,0,0.3);
    }

    .invitation .emoji {
      font-size: 90px;
    }

    .invitation h2 {
      font-size: 42px;
      margin: 20px;
      color: #fff176;
    }

    .invitation p {
      font-size: 20px;
      line-height: 1.8;
    }

    .party-button {
      margin-top: 30px;
      border: none;
      padding: 15px 35px;
      border-radius: 30px;

      font-size: 18px;
      font-weight: bold;
      cursor: pointer;

      color: #7b1fa2;

      background: linear-gradient(
        135deg,
        #fff700,
        #ffca28,
        #ff9800
      );

      box-shadow: 0 8px 25px rgba(0,0,0,0.3);

      transition: 0.3s;
    }

    .party-button:hover {
      transform: scale(1.1);
    }

    footer {
      position: relative;
      z-index: 3;
      text-align: center;

      padding: 30px 20px;
      background: rgba(0,0,0,0.30);

      font-size: 17px;
    }

    /* Confetti */
    .confetti {
      position: fixed;
      width: 10px;
      height: 10px;
      top: -15px;
      z-index: 999;
      animation: fall linear forwards;
    }

    @keyframes fall {
      to {
        transform: translateY(110vh) rotate(720deg);
      }
    }

    @media(max-width: 600px) {

      .hero-box {
        padding: 40px 20px;
      }

      .cake {
        font-size: 75px;
      }

      .event-box {
        padding: 25px 15px;
      }

      .event-row {
        align-items: flex-start;
      }

      nav {
        gap: 8px;
      }

      nav a {
        padding: 6px 10px;
        font-size: 14px;
      }

    }

  </style>
</head>

