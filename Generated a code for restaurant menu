<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Rainbow Flavors Restaurant</title>

<style>
*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:'Poppins',sans-serif;
scroll-behavior:smooth;
}

body{
background:linear-gradient(135deg,#ffecd2,#fcb69f,#ff9a9e,#fad0c4);
}

header{
background:linear-gradient(90deg,#ff512f,#dd2476);
padding:15px;
position:sticky;
top:0;
z-index:1000;
box-shadow:0 4px 10px rgba(0,0,0,0.2);
}

.navbar{
display:flex;
justify-content:space-between;
align-items:center;
max-width:1200px;
margin:auto;
}

.logo{
font-size:30px;
font-weight:bold;
color:white;
}

.nav-links{
display:flex;
gap:20px;
}

.nav-links a{
text-decoration:none;
color:white;
font-weight:bold;
transition:0.3s;
}

.nav-links a:hover{
color:yellow;
}

.hero{
height:70vh;
background:url('https://images.unsplash.com/photo-1504674900247-0877df9cc836?w=1600') center/cover;
display:flex;
justify-content:center;
align-items:center;
text-align:center;
color:white;
}

.hero h1{
font-size:60px;
background:rgba(0,0,0,0.5);
padding:20px;
border-radius:20px;
}

.section{
padding:50px 20px;
}

.section h2{
text-align:center;
font-size:40px;
margin-bottom:30px;
color:#d62828;
}

.menu-grid{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(280px,1fr));
gap:25px;
max-width:1200px;
margin:auto;
}

.card{
background:white;
border-radius:20px;
overflow:hidden;
box-shadow:0 8px 15px rgba(0,0,0,0.15);
transition:0.4s;
}

.card:hover{
transform:translateY(-10px) scale(1.03);
}

.card img{
width:100%;
height:220px;
object-fit:cover;
}

.card-content{
padding:20px;
}

.card-content h3{
color:#ff5722;
margin-bottom:10px;
}

.price{
font-size:20px;
font-weight:bold;
color:green;
margin-top:10px;
}

footer{
background:#222;
color:white;
text-align:center;
padding:20px;
margin-top:40px;
}
</style>
</head>

<body>

<header>
<div class="navbar">
